* {
  box-sizing: border-box;
}

:root {
  font-family: 'Inter', sans-serif;
  color: #edeeff;
  background: #07111f;
  line-height: 1.5;
  font-weight: 400;
  color-scheme: dark;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(99, 102, 241, 0.28), transparent 25%),
    radial-gradient(circle at right, rgba(14, 165, 233, 0.25), transparent 30%),
    #07111f;
}

body {
  min-height: 100vh;
}

button, input, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  padding: 24px;
  gap: 24px;
}

.sidebar {
  width: 280px;
  background: rgba(11, 18, 32, 0.88);
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 26px;
  padding: 22px 18px;
  backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  background: linear-gradient(135deg, #67e8f9, #818cf8);
  display: grid;
  place-items: center;
  font-size: 1.7rem;
  font-weight: 800;
  color: #051120;
}

.brand-block h1,
.brand-block h2 {
  margin: 0;
  font-size: 1.5rem;
}

.brand-block p {
  margin: 0;
  color: #93c5fd;
  font-size: 0.86rem;
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.nav-item {
  width: 100%;
  text-align: left;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(15, 23, 42, 0.7);
  color: #e2e8f0;
  padding: 12px 14px;
  border-radius: 14px;
  font-weight: 600;
  transition: all 0.2s ease;
}

.nav-item.active,
.nav-item:hover {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.28), rgba(125, 211, 252, 0.15));
  border-color: rgba(125, 211, 252, 0.5);
}

.avatar-card,
.mini-panel {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 20px;
  padding: 16px;
}

.avatar-card {
  display: flex;
  align-items: center;
  gap: 12px;
}

.avatar,
.mini-avatar,
.hero-avatar {
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: linear-gradient(135deg, #67e8f9, #818cf8);
  color: #051120;
  font-weight: 800;
}

.avatar {
  width: 52px;
  height: 52px;
  font-size: 1.3rem;
}

.avatar-card strong,
.avatar-card span,
.mini-panel p,
.mini-panel h3,
.mini-panel span {
  display: block;
}

.avatar-card strong,
.friend-item strong,
.lesson-card h3,
.card h2,
.card h3 {
  margin: 0;
}

.avatar-card span,
.mini-panel span,
.friend-item small,
.lesson-card p,
.card p,
.eyebrow,
.character-pill small {
  color: #cbd5e1;
}

.mini-panel p {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.72rem;
  color: #93c5fd;
}

.mini-panel h3 {
  font-size: 2rem;
  margin: 6px 0;
}

.main-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 22px;
  padding: 18px 20px;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.8rem, 3vw, 2.7rem);
}

.eyebrow {
  margin: 0 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.72rem;
  color: #93c5fd;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.primary,
.secondary {
  border: none;
  border-radius: 14px;
  padding: 11px 18px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary {
  background: linear-gradient(135deg, #60a5fa, #a78bfa);
  color: #eff6ff;
}

.secondary {
  background: rgba(148, 163, 184, 0.1);
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.16);
}

.primary:hover,
.secondary:hover,
.nav-item:hover,
.account-card:hover {
  transform: translateY(-1px);
}

.screen-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.card {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 24px;
  padding: 20px;
}

.hero-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 240px;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.18), rgba(18, 194, 233, 0.1));
}

.hero-card h2 {
  font-size: 2.3rem;
  margin-bottom: 12px;
}

.hero-avatar {
  width: 120px;
  height: 120px;
  font-size: 2.8rem;
  box-shadow: 0 0 30px rgba(125, 211, 252, 0.4);
}

.character-grid,
.lesson-row,
.menu-list,
.friend-list,
.account-list,
.helper-questions {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.character-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(110px, 1fr));
}

.character-pill {
  border-radius: 18px;
  padding: 12px 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #06131d;
  font-weight: 700;
}

.wide-card {
  grid-column: 1 / -1;
}

.lesson-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
}

.lesson-box,
.lesson-card,
.friend-item,
.account-card,
.helper-item {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
  padding: 16px;
}

.lesson-topline,
.friend-item,
.account-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.lesson-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lesson-box span,
.lesson-card span,
.lesson-box small,
.lesson-card small,
.friend-item span,
.account-card span {
  color: #93c5fd;
}

.lesson-box strong,
.friend-item strong,
.account-card strong {
  font-size: 1.02rem;
}

.lesson-box em {
  color: #8be9ac;
  font-style: normal;
}

.friend-form,
.profile-form,
.register-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

input,
select,
textarea {
  width: 100%;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.16);
  color: #e2e8f0;
  outline: none;
  border-radius: 14px;
  padding: 12px 14px;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

.friend-item {
  padding: 14px 16px;
}

.mini-avatar {
  width: 36px;
  height: 36px;
  font-size: 0.9rem;
}

.friend-item div {
  flex: 1;
}

.account-card {
  text-align: left;
  width: 100%;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.12);
  color: #e2e8f0;
}

.account-card.active {
  border-color: rgba(125, 211, 252, 0.6);
  background: rgba(59, 130, 246, 0.12);
}

.profile-actions {
  margin-top: 16px;
}

.auth-shell {
  justify-content: center;
  align-items: center;
}

.auth-panel {
  width: min(520px, 90vw);
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 28px;
  padding: 28px;
  box-shadow: 0 30px 60px rgba(2, 6, 23, 0.45);
}

.mini-note {
  color: #cbd5e1;
  margin-top: 16px;
  margin-bottom: 18px;
  font-size: 0.94rem;
}

.flash-message {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: #d1fae5;
  border-radius: 14px;
  padding: 10px 12px;
  font-size: 0.92rem;
}

.helper-gate {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.helper-item {
  color: #e2e8f0;
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }
}
